{
  "manifest_version": 3,
  "name": "Open in Spoty",
  "description": "Open Spotify links in the Spoty desktop app.",
  "version": "1.0.0",
  "key": "",
  "permissions": ["declarativeNetRequestWithHostAccess", "nativeMessaging"],
  "host_permissions": ["https://open.spotify.com/*"],
  "declarative_net_request": {
    "rule_resources": [
      { "id": "spotify_links", "enabled": true, "path": "rules.json" }
    ]
  },
  "web_accessible_resources": [
    { "resources": ["open.html"], "matches": ["<all_urls>"] }
  ]
}
